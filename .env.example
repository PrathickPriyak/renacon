# SQLite (local) — path is relative to prisma/schema.prisma
DATABASE_URL="file:../data/renacon.db"

# Postgres (Vercel / production) — change prisma/schema.prisma provider to "postgresql" too:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional secret for /admin/submissions and /api/*/export
ADMIN_SECRET=""

# Google Sheet for live form rows (your shared workbook)
GOOGLE_SHEETS_SPREADSHEET_ID="1IXkszTmv_qUOpq8VZXYWjQn7--G3cC9kqlOVbZfwtWA"

# Option A (recommended): Google Cloud service account JSON (single line) OR email + private key.
# Share the spreadsheet with the service account email as Editor.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}
# GOOGLE_SERVICE_ACCOUNT_EMAIL="renacon-sheets@YOUR_PROJECT.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Apps Script web app URL (paste scripts/google-sheets-apps-script.js into the sheet, deploy as Web app)
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXX/exec"
