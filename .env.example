# SQLite (local) — path is relative to prisma/schema.prisma
DATABASE_URL="file:../data/renacon.db"

# Postgres (Vercel / production) — change prisma/schema.prisma provider to "postgresql" too:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional secret for /admin/submissions and /api/*/export
ADMIN_SECRET=""
