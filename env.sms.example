# Copy to .env.local for local testing, and set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Required for real SMS OTP in production (pick ONE provider) ---

# Option A: MSG91 (recommended for India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RENACN
# DLT-approved OTP template id from MSG91 dashboard (recommended)
MSG91_TEMPLATE_ID=

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option C: Fast2SMS
FAST2SMS_API_KEY=

# Optional: force provider order — msg91 | twilio | fast2sms
SMS_PROVIDER=msg91

# Set to true ONLY for local UI testing without SMS
# OTP_DEMO_MODE=true
