# Copy to .env.local for local testing, and set the same keys in Vercel → Project → Settings → Environment Variables
# (Production / Preview / Development as needed).

# --- Required for real SMS OTP in production (pick ONE provider) ---
# If none of these are set, /api/otp/send/ runs in demoMode and returns `devOtp`
# in the JSON response so brochure forms still work for QA.

# Option A: MSG91 (recommended for India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RENACN
# DLT-approved OTP template id from MSG91 dashboard (recommended)
MSG91_TEMPLATE_ID=

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option C: Fast2SMS
FAST2SMS_API_KEY=

# Optional: force provider order — msg91 | twilio | fast2sms
SMS_PROVIDER=msg91

# Force demo mode even if SMS keys exist (local UI testing only)
# OTP_DEMO_MODE=true

# Fail closed (no demo OTP) when SMS is not configured — usually leave unset
# OTP_REQUIRE_SMS=1
